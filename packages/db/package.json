{
  "name": "@faralin/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "generate:ci": "prisma generate --schema prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:ci": "prisma migrate deploy --schema prisma/schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push",
    "push:ci": "prisma db push --schema prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:universities": "dotenv -e ../../.env -- tsx prisma/seed-universities.ts",
    "seed:universities:ci": "tsx prisma/seed-universities.ts",
    "sync:university-faralin-rules": "dotenv -e ../../.env -- tsx prisma/sync-university-faralin-rules.ts",
    "sync:university-faralin-rules:ci": "tsx prisma/sync-university-faralin-rules.ts",
    "backfill:university-assessment-config": "dotenv -e ../../.env -- tsx prisma/backfill-university-assessment-config.ts",
    "backfill:university-assessment-config:ci": "tsx prisma/backfill-university-assessment-config.ts",
    "backfill:institutional-engagement-phase2": "dotenv -e ../../.env -- tsx prisma/backfill-institutional-engagement-phase2.ts",
    "backfill:institutional-engagement-phase2:ci": "tsx prisma/backfill-institutional-engagement-phase2.ts",
    "backfill:support-categories": "dotenv -e ../../.env -- tsx prisma/backfill-support-categories.ts",
    "backfill:support-categories:ci": "tsx prisma/backfill-support-categories.ts",
    "seed:ci": "tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@clerk/backend": "^1.34.0",
    "@faralin/types": "workspace:*",
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
